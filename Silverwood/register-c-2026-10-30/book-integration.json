  "textEdits": [
    {
      "originalPage": 46,
      "before": "<figure class=\"swpilot-scene\"><img src=\"https://raw.githubusercontent.com/Omegaoliverid/Public-images/67124c193e8b5fa3c01f0682bcd24c4230fa89a3/Silverwood/book-continuity-2026-10-29/silverwood-l1.webp\" alt=\"Silverwood — accepted ground level\"/></figure>",
      "after": "<figure class=\"swpilot-scene\"><img src=\"https://raw.githubusercontent.com/Omegaoliverid/Public-images/3f831e1679bcc1df5925d9fa38e5a6717ea5db26/Silverwood/register-c-2026-10-30/c01-silverwood-at-a-glance-v04.webp\" alt=\"Silverwood from the north plateau, beyond the caravan\"/></figure>",
      "reason": "Approved C01 replaces repeated ground-level map; atlas remains."
    },
    {
      "originalPage": 46,
      "before": "Silverwood clings to the side of the mountain like moss on a stone: walls, towers and houses stacked on houses, stairways and bridges threaded between them. Even at this hour the streets are busy.",
      "after": "Silverwood stands on a broad mountain shelf, its old walls enclosing tightly clustered houses, stairways and bridges. In the midday light, the streets are busy.",
      "reason": "Author-approved flat plateau and midday arrival."
    },
    {
      "originalPage": 46,
      "before": "Above it all, on the mountain, a lone tower catches the first light.",
      "after": "At the northwest corner, a crane rises from the Bazaar’s round stone tower.",
      "reason": "North approach image excludes Xanthos behind the viewer."
    },
    {
      "originalPage": 80,
      "before": "The open-air **pavilion of the Pantheon**, with its great prayer floor and shrines to a dozen gods. Open to all.",
      "after": "The enclosed **prayer hall of the Pantheon**, with its great prayer floor, side galleries and shrines to a dozen gods. Open to all.",
      "reason": "Author-approved enclosed C05 hall."
    },
    {
      "originalPage": 264,
      "before": "He shows them the chamber on L5 **from its doorway only**:",
      "after": "He shows them the chamber on L5 **from the levitating platform only**:",
      "reason": "Approved P3 lift viewpoint; no invented front doorway."
    },
    {
      "originalPage": 280,
      "before": "**The machine:** a vast apparatus like an astronomical clock, with rune-carved panels, gears, crystals and levers.",
      "after": "**The machine:** an elegant brass-and-silver armillary orrery. Slender rings carry metal planets around a central blue diamond; two matching round sigils lie side by side on the floor before it. Fine gears, rune-carved controls, crystals and levers form the apparatus.",
      "reason": "Approved P3 slender orrery and two floor sigils; trap mechanics unchanged."
    },
    {
      "originalPage": 53,
      "before": "{{footnote SHADOW OVER SILVERWOOD / GM REFERENCE}}",
      "after": "<figure class=\"sw-art-opener\"><img src=\"https://raw.githubusercontent.com/Omegaoliverid/Public-images/3f831e1679bcc1df5925d9fa38e5a6717ea5db26/Silverwood/register-c-2026-10-30/c02-guild-notice-board-v01.webp\" alt=\"The Guild notice board in the Shaft and Pickaxe\"/></figure>\n\n{{footnote SHADOW OVER SILVERWOOD / GM REFERENCE}}",
      "reason": "Reuse approved mirrored C02 on Copper opener."
    },
    {
      "originalPage": 340,
      "before": "https://raw.githubusercontent.com/Omegaoliverid/Public-images/main/Silverwood/production-2026-10-25/npc-032-vartius-xanthos.webp",
      "after": "https://raw.githubusercontent.com/Omegaoliverid/Public-images/3f831e1679bcc1df5925d9fa38e5a6717ea5db26/Silverwood/register-c-2026-10-30/p2-young-lord-xanthos-v02.webp",
      "reason": "Use the approved current young face in the Mithril combat reference; preserve founder portrait in Secret History."
    }
  ],
